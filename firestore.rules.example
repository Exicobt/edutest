rules_version = '2';

// CONTOH aturan untuk fitur profil, gambar soal, dan multiplayer.
// Gabungkan dengan aturan yang sudah ada di Firebase Console (jangan ditimpa begitu saja).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /quis/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.pembuat == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.get('pembuat', '') == request.auth.uid;

      // Gambar soal; getAfter() agar bisa ditulis dalam batch yang sama dengan dokumen kuis
      match /gambar/{gid} {
        allow read: if true;
        allow write: if request.auth != null
          && getAfter(/databases/$(database)/documents/quis/$(id)).data.pembuat == request.auth.uid;
      }
    }

    match /ruang/{kode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Pemain: host tidak boleh menjadi pemain, bergabung hanya saat lobi
      match /pemain/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/ruang/$(kode)).data.hostUid != uid
          && get(/databases/$(database)/documents/ruang/$(kode)).data.status == 'lobi';
        allow update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/ruang/$(kode)).data.hostUid == request.auth.uid);
      }
    }
  }
}
